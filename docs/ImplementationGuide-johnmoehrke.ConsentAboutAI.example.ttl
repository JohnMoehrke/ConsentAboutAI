       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Consent for Machine Learning Training" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Consent for using data for machine learning training purposes." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "true"^^xsd:boolean ]
     ], [
