         fhir:link <http://johnmoehrke.github.io/ConsentAboutAI/Consent/AllowMLtrainingOnDeIdentifiedData> ;
         fhir:Reference.reference [ fhir:value "Consent/AllowMLtrainingOnDeIdentifiedData" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Consent for Machine Learning Training on De-Identified Data" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Consent for using de-identified data for machine learning training purposes." ] ;
       fhir:ImplementationGuide.definition.resource.exampleCanonical [
         fhir:value "http://johnmoehrke.github.io/ConsentAboutAI/StructureDefinition/ConsentWithLimits" ;
         fhir:link <http://johnmoehrke.github.io/ConsentAboutAI/StructureDefinition/ConsentWithLimits>
       ]
     ], [
       fhir:index 4 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "Consent" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://johnmoehrke.github.io/ConsentAboutAI/Consent/AllowSpecificAIforSpecificPurpose> ;
         fhir:Reference.reference [ fhir:value "Consent/AllowSpecificAIforSpecificPurpose" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Consent to allow specific AI for a specific purpose" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Consent to allow the use of a specific AI device for a specific purpose.\r\nIn this case a Device is used to represent the specific AI system or model. In this case the purpose is for CDS use." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 5 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "Consent" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://johnmoehrke.github.io/ConsentAboutAI/Consent/DenyCDS> ;
         fhir:Reference.reference [ fhir:value "Consent/DenyCDS" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Consent to disallow Clinical Decision Support" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Consent to disallow using data for clinical decision support purposes." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 6 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "Consent" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://johnmoehrke.github.io/ConsentAboutAI/Consent/DenyMLtraining> ;
         fhir:Reference.reference [ fhir:value "Consent/DenyMLtraining" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Consent to disallow Machine Learning Training" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Consent to disallow using data for machine learning training purposes." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 7 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "Consent" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://johnmoehrke.github.io/ConsentAboutAI/Consent/AllAiProvisions> ;
         fhir:Reference.reference [ fhir:value "Consent/AllAiProvisions" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Consent with all kinds of Provisions" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Consent that includes provisions using the various AI mechanisms along with normal TPO.\r\n\r\nThis consent \r\n1. permits the patient's care team to have full access\r\n2. permits TPO purposes to have access to Normal data, but not sensitive data\r\n3. permits ML training purposes to have access to Normal de-identified data, but not sensitive data\r\n\r\nGiven that FHIR R4 Consent has only ONE root level provision, we need to extra deep nesting:\r\n\r\nProvisions\r\n- Permit all the purposes\r\n  - deny ML training for sensitive data\r\n    - permit ML training for de-identified data\r\n  - deny TPO -- just so we can skip to a permit\r\n    - permit TPO for normal confidentiality\r\n    - permit TPO for the care team for sensitive data" ] ;
       fhir:ImplementationGuide.definition.resource.exampleCanonical [
         fhir:value "http://johnmoehrke.github.io/ConsentAboutAI/StructureDefinition/ConsentWithLimits" ;
         fhir:link <http://johnmoehrke.github.io/ConsentAboutAI/StructureDefinition/ConsentWithLimits>
       ]
     ], [
       fhir:index 8 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:resource" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://johnmoehrke.github.io/ConsentAboutAI/StructureDefinition/ConsentWithLimits> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/ConsentWithLimits" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Consent with use of the Limits extension" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Consent profile that includes the use of the consent-provision-limit extension to express limits on the use of data for ML training." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 9 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "Patient" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://johnmoehrke.github.io/ConsentAboutAI/Patient/ex-patient> ;
         fhir:Reference.reference [ fhir:value "Patient/ex-patient" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "The Patient example" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "The patient example is a patient named John Jacob Jingleheimer Schmidt, who has a variety of names and identifiers. This example is used to demonstrate the use of multiple names, identifiers, and other patient attributes in FHIR. This is the patient giving consent for the use of their data for AI/ML training, with specific limits on the use of that data." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "true"^^xsd:boolean ]
     ] ;
