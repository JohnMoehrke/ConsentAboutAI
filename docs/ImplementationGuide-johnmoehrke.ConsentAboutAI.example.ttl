         fhir:Reference.reference [ fhir:value "Consent/AllowCDS" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Consent for Clinical Decision Support" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Consent for using data for clinical decision support purposes." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 2 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
